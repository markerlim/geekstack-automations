# Copy to .env and fill in:  cp .env.example .env
# .env is gitignored -- never commit real values. Only the names and placeholders live here.
#
# Marked [required] = most scrapers fail without it; [optional] = only for the feature named.
# The same names are used as GitHub Actions secrets/variables (see .github/workflows/*.yml).

# --- MongoDB (all scrapers, price upload, Discord/wiki apply scripts) -------------------------
MONGO_DATABASE=geekstack            # [required]
MONGO_USER=                         # [required]
MONGO_PASSWORD=                     # [required]
MONGO_CLUSTER=                      # [required] cluster host, e.g. cluster0.xxxxx.mongodb.net

# --- Card collections (Mongo collection names, one per game) ---------------------------------
C_UNIONARENA=                       # Union Arena cards (also used by `make ua-discord-*`)
C_DUELMASTERS=                      # Duel Masters cards (also used by `make dm-wiki*`)
C_ONEPIECE=
C_GUNDAM=
C_LORCANA=
C_RIFTBOUND=
C_HAIKYUU=
C_HOLOLIVE=
C_COOKIERUN=
C_DRAGONBALLZFW=
C_WSB=
C_BOOSTERLIST=                      # [optional] booster list collection; defaults to "BoosterList"
BT_HAIKYUUBREAK=                    # Haikyu!! booster collection

# --- Google Cloud Storage (card images / backups) ---------------------------------------------
# Credentials: either point at a service-account key file, or set the JSON inline.
GOOGLE_APPLICATION_CREDENTIALS=     # path to the service-account .json (e.g. ./credentials/gcp.json)
# GOOGLE_SERVICE_ACCOUNT_JSON=      # [optional] alternative: the whole key JSON as one line
GCS_ONEPIECE=                       # image path prefixes per game
GCS_GUNDAM=
GCS_HAIKYUU=
GCS_LORCANA=

# --- OpenRouter (AI translation) ---------------------------------------------------------------
OPENROUTER_API_KEY=                 # [required for Union Arena translation] keep secret; rotate if it leaks
OPENROUTER_MODEL=                   # e.g. google/gemini-3-flash-preview

# --- GitHub ------------------------------------------------------------------------------------
# Used to read/write unionarenadb/ and duelmasterdb/ JSON via the GitHub API.
# LEAVE UNSET when running locally: the scrapers then read/write the repo files directly
# (local mode; you commit the changes yourself). Set only in CI.
# GITHUB_TOKEN=
# LOCAL_FILES=1                     # [optional] force local mode even if GITHUB_TOKEN is set

# --- Discord (Union Arena community translations: `make ua-discord-export`) ---------------------
# Your account/bot token for DiscordChatExporter. Treat like a password; it is never printed.
# A password change invalidates old tokens, so re-copy it afterwards.
DISCORD_TOKEN=

# --- Email notifications (new-series alerts; optional, skipped with a warning if unset) ---------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
TRELLO_EMAIL=                       # default recipient

# --- Jihuanshe (JHS) price scraper ---------------------------------------------------------------
# The Android emulator route (jihuanshe/main.py, `make jhs-*`) needs only the SDK location:
ANDROID_SDK_ROOT=                   # e.g. ~/Library/Android/sdk (ANDROID_HOME also works)
# Old API client / tests (jihuanshe/client.py, deprecated/): your own account only
# JHS_ENV=uat                       # prod | uat | testing
# JHS_TOKEN=
# JHS_USERNAME=
# JHS_PASSWORD=
